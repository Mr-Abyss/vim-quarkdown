vim9script
# vim-quarkdown: access to the bundled stdlib function catalogue.
#
# data/stdlib.json is generated by scripts/gen-stdlib-data.js, which queries
# the quarkdown language server for every stdlib function (name, signature,
# parameters, markdown documentation). It is read lazily and only powers the
# client-less completion (:h quarkdown-completion) and :QuarkdownDoc; with an
# LSP client attached, live server data is used instead.

var scriptPath = fnamemodify(expand('<script>'), ':p')
var cache: dict<any> = {}

def EnsureLoaded()
  if has_key(cache, 'loaded')
    return
  endif
  cache.functions = []
  cache.byName = {}
  cache.loaded = false
  var path = fnamemodify(scriptPath, ':h:h:h') .. '/data/stdlib.json'
  if filereadable(path)
    try
      # plain text mode: the JSON is UTF-8 with LF endings; note that
      # readfile(path, 'B') would return a Blob, not a list
      var data = json_decode(join(readfile(path), "\n"))
      if type(data) == v:t_dict && type(get(data, 'functions', [])) == v:t_list
        cache.functions = data.functions
        for f in cache.functions
          if type(f) == v:t_dict
            cache.byName[get(f, 'name', '')] = f
          endif
        endfor
        cache.loaded = true
      endif
    catch
      # malformed data file: keep cache.loaded = false
    endtry
  endif
enddef

# All stdlib function entries: {name, module, signature, params, doc}.
export def Functions(): list<dict<any>>
  EnsureLoaded()
  return cache.functions
enddef

# Look up one function by exact name; {} when unknown.
export def Find(name: string): dict<any>
  EnsureLoaded()
  return get(cache.byName, name, {})
enddef

# Whether the bundled catalogue could be loaded.
export def Loaded(): bool
  EnsureLoaded()
  return cache.loaded
enddef
